// ??????? ??????????? ?????? ??????????
void resetDevice(void)
{
   delay_ms(10);
   output_low(NRST_Pin);
   delay_ms(2);
   output_high(NRST_Pin);
   delay_ms(25);
}

// ????? ???? BUSY ? ????????? ??????
void checkBusy(void)
{
   unsigned int8 busy_timeout_cnt = 0;
   while(input(BUSY_Pin))
   {
      delay_ms(1);
      busy_timeout_cnt++;
      if (busy_timeout_cnt > 10)
      {
         busy_timeout_cnt = 0;
         resetDevice();
         break;
      }
   }
}

// ??????? ???? ? ????? Standby
void SetStandby(unsigned int8 StdbyConfig)
{
   checkBusy();
   unsigned int8 command = 0x80;
   output_low(NSS_Pin);
   spi_xfer(SX1268_SPI, command);
   spi_xfer(SX1268_SPI, StdbyConfig);
   output_high(NSS_Pin);
}

// ????????????? ??????? ?????? ??????? ? ??????? ?????? ?? SPI
void WriteCommand(unsigned int8 command, unsigned int8 *buffer, unsigned int16 size)
{
   unsigned int16 index;
   checkBusy();
   output_low(NSS_Pin);
   spi_xfer(SX1268_SPI, command);
   for (index = 0; index < size; index++)
   {
      spi_xfer(SX1268_SPI, buffer[index]);
   }
   output_high(NSS_Pin);
}

// ?????? ?????? ?????? ? FIFO ????? ??????????
void WriteBuffer(unsigned int8 *data, unsigned int8 size, unsigned int8 offset)
{
   unsigned int8 index;
   unsigned int8 command = 0x0E;
   checkBusy();
   output_low(NSS_Pin);
   spi_xfer(SX1268_SPI, command);
   spi_xfer(SX1268_SPI, offset);
   for (index = 0; index < size; index++)
   {
      spi_xfer(SX1268_SPI, data[index]);
   }
   output_high(NSS_Pin);
}

void SetPacketType(void)
{
   WriteCommand(0x8A, &packettype, 1);
}

void SetRfFrequency(void)
{
   unsigned int8 buffer[4];
   unsigned int32 freq;
   freq = (unsigned int32)(frequency / 0.95367431640625);
   buffer[0] = (unsigned int8)(freq >> 24);
   buffer[1] = (unsigned int8)(freq >> 16);
   buffer[2] = (unsigned int8)(freq >> 8);
   buffer[3] = (unsigned int8)(freq);
   WriteCommand(0x86, buffer, 4);
}

void SetModulationParams(void)
{
   unsigned int8 buffer[4];
   buffer[0] = spreadingFactor;
   buffer[1] = bandwidth;
   buffer[2] = codeRate;
   buffer[3] = optimisation;
   WriteCommand(0x8B, buffer, 4);
}

void SetPacketParams(void)
{
   unsigned int8 preambleMSB, preambleLSB;
   preambleMSB = (unsigned int8)(preambleLength >> 8);
   preambleLSB = (unsigned int8)(preambleLength);
   unsigned int8 buffer[9];
   buffer[0] = preambleMSB;
   buffer[1] = preambleLSB;
   buffer[2] = headerType;
   buffer[3] = payloadLength;
   buffer[4] = crcType;
   buffer[5] = invertIQ;
   buffer[6] = 0xFF;
   buffer[7] = 0xFF;
   buffer[8] = 0xFF;
   WriteCommand(0x8C, buffer, 9);
}

void SetPaConfig(void)
{
   unsigned int8 buffer[4];
   buffer[0] = paDutyCycle;
   buffer[1] = hpMax;
   buffer[2] = deviceSel;
   buffer[3] = paLut;
   WriteCommand(0x95, buffer, 4);
}

void SetTxParams(void)
{
   unsigned int8 buffer[2];
   buffer[0] = (unsigned int8)txpower;
   buffer[1] = rampTime;
   WriteCommand(0x8E, buffer, 2);
}

void setDIO3AsTCXOCtrl(unsigned int8 tcxoVoltage)
{
   if (tcxoVoltage != 0xFF)
   {
      unsigned int8 buffer[4];
      buffer[0] = tcxoVoltage;
      buffer[1] = 0x00;
      buffer[2] = 0x00;
      buffer[3] = 0x64;
      WriteCommand(0x97, buffer, 4);
   }
}

// ?????????? ??????? ????????? DIO2 ??? ????????????? RF-Antenna
void setDIO2AsRfSwitchCtrl(unsigned int8 enable)
{
   unsigned int8 buffer;
   buffer = enable; 
   WriteCommand(0x9D, &buffer, 1);
}

void SetBufferBaseAddress(void)
{
   unsigned int8 buffer[2];
   buffer[0] = txBaseAddress;
   buffer[1] = rxBaseAddress;
   WriteCommand(0x8F, buffer, 2);
}

// ??????????? ????????????? LoRa ???????????
void SetupLoRa(void)
{
   SetStandby(0x00);
   SetPacketType();
   SetRfFrequency();
   SetModulationParams();
   SetPacketParams();
   SetPaConfig();
   SetTxParams();
   setDIO3AsTCXOCtrl(0x07);
   SetBufferBaseAddress();
   setDIO2AsRfSwitchCtrl(0x01); // ?????????????? ???????????? TXEN/RXEN
}

void SetDioIrqParams(unsigned int16 irqMask, unsigned int16 dio1Mask, unsigned int16 dio2Mask, unsigned int16 dio3Mask)
{
   unsigned int8 buffer[8];
   buffer[0] = (unsigned int8)(irqMask >> 8);
   buffer[1] = (unsigned int8)(irqMask);
   buffer[2] = (unsigned int8)(dio1Mask >> 8);
   buffer[3] = (unsigned int8)(dio1Mask);
   buffer[4] = (unsigned int8)(dio2Mask >> 8);
   buffer[5] = (unsigned int8)(dio2Mask);
   buffer[6] = (unsigned int8)(dio3Mask >> 8);
   buffer[7] = (unsigned int8)(dio3Mask);
   WriteCommand(0x08, buffer, 8);
}

void SetTx(void)
{
   unsigned int8 buffer[3];
   unsigned int32 timeout_calc = txtimeout << 6; // ?????? ?? ????????????
   buffer[0] = (unsigned int8)(timeout_calc >> 16);
   buffer[1] = (unsigned int8)(timeout_calc >> 8);
   buffer[2] = (unsigned int8)(timeout_calc);
   WriteCommand(0x83, buffer, 3);
}

void ClearIrqStatus(unsigned int16 irqMask)
{
   unsigned int8 buffer[2];
   buffer[0] = (unsigned int8)(irqMask >> 8);
   buffer[1] = (unsigned int8)(irqMask);
   WriteCommand(0x12, buffer, 2);
}

// ????????? ???????? ??????????????? ?????? ? ????
void Transmit(void)
{
   SetDioIrqParams(0x0201, 0x0201, 0x0000, 0x0000);
   SetTx();
   while (!input(DIO1_Pin)); // ???????? ????????? ???????? ?? ?????????? ?? DIO1
   ClearIrqStatus(0xFFFF);
}

void main(void)
{
   unsigned int8 i;
   unsigned int8 txbuffer[10];

   // ????????? ????????? ????????? ??????????? ?????
   output_high(NSS_Pin);
   output_high(NRST_Pin);

   // ?????? ???????????? LoRa
   SetupLoRa();

   while (TRUE)
   {
      for (i = 0; i < 60; i++)
      {
         memset(txbuffer, 0, sizeof(txbuffer));
         sprintf((char *)txbuffer, "%u seconds", i); 
         
         WriteBuffer(txbuffer, sizeof(txbuffer), 0x00);
         Transmit();
         delay_ms(1000);
      }
   }
}

