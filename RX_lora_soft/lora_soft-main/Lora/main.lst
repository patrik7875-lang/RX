.................... 
.................... // =====================================================
.................... // READ PACKET RSSI
.................... // SX1268 GetPacketStatus command: 0x14
.................... // RSSI dBm = -rssi_raw / 2
.................... // =====================================================
.................... 
.................... signed int8 GetPacketRSSI(void)
.................... {
....................    unsigned int8 rssi_raw;
.................... 
....................    checkBusy();
*
06A4:  RCALL  01BE
.................... 
....................    output_low(NSS_Pin);
06A6:  BCF    F94.1
06A8:  BCF    F8B.1
.................... 
....................    spi_xfer(SPI_1, 0x14);
06AA:  MOVLW  14
06AC:  MOVWF  5E
06AE:  RCALL  01DE
....................    spi_xfer(SPI_1, 0x00);
06B0:  CLRF   5E
06B2:  RCALL  01DE
.................... 
....................    rssi_raw = spi_xfer(SPI_1, 0x00);
06B4:  CLRF   5E
06B6:  RCALL  01DE
06B8:  MOVF   01,W
06BA:  MOVFF  00,3D
.................... 
....................    // Read remaining packet status bytes
....................    spi_xfer(SPI_1, 0x00);
06BE:  CLRF   5E
06C0:  RCALL  01DE
....................    spi_xfer(SPI_1, 0x00);
06C2:  CLRF   5E
06C4:  RCALL  01DE
.................... 
....................    output_high(NSS_Pin);
06C6:  BCF    F94.1
06C8:  BSF    F8B.1
.................... 
....................    return (signed int8)(-((unsigned int16)rssi_raw / 2));
06CA:  CLRF   3F
06CC:  BCF    FD8.0
06CE:  RRCF   3F,W
06D0:  MOVWF  03
06D2:  RRCF   3D,W
06D4:  MOVWF  02
06D6:  XORLW  FF
06D8:  ADDLW  01
06DA:  MOVWF  00
06DC:  MOVLW  00
06DE:  SUBFWB 03,F
06E0:  MOVFF  00,01
06E4:  GOTO   09B0 (RETURN)
.................... }
