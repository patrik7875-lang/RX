.................... 
.................... unsigned int16 GetIrqStatus(void)
.................... {
....................    unsigned int8 msb, lsb;
.................... 
....................    checkBusy();
*
05DE:  RCALL  01BE
.................... 
....................    output_low(NSS_Pin);
05E0:  BCF    F94.1
05E2:  BCF    F8B.1
....................    spi_xfer(SPI_1, 0x12);
05E4:  MOVLW  12
05E6:  MOVWF  5E
05E8:  RCALL  01DE
....................    spi_xfer(SPI_1, 0x00);
05EA:  CLRF   5E
05EC:  RCALL  01DE
.................... 
....................    msb = spi_xfer(SPI_1, 0x00);
05EE:  CLRF   5E
05F0:  RCALL  01DE
05F2:  MOVF   01,W
05F4:  MOVFF  00,3D
....................    lsb = spi_xfer(SPI_1, 0x00);
05F8:  CLRF   5E
05FA:  RCALL  01DE
05FC:  MOVF   01,W
05FE:  MOVFF  00,3E
.................... 
....................    output_high(NSS_Pin);
0602:  BCF    F94.1
0604:  BSF    F8B.1
.................... 
....................    return ((unsigned int16)msb << 8) | lsb;
0606:  CLRF   3F
0608:  MOVF   3F,W
060A:  IORWF  3E,W
060C:  MOVFF  3D,03
0610:  MOVWF  01
0612:  MOVFF  3D,02
0616:  GOTO   0958 (RETURN)
.................... }
