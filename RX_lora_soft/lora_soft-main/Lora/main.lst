0726:  ADDWF  46,W
0728:  MOVWF  01
072A:  MOVLW  00
072C:  ADDWFC 47,W
072E:  MOVWF  03
0730:  MOVFF  01,FE9
0734:  MOVWF  FEA
0736:  MOVFF  FEF,5E
073A:  RCALL  01DE
073C:  INCF   4A,F
073E:  BRA    071E
.................... 
....................    output_high(NSS_Pin);
0740:  BCF    F94.1
0742:  BSF    F8B.1
0744:  GOTO   07A0 (RETURN)
.................... }
