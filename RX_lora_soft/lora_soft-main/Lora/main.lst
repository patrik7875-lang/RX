....................    spi_xfer(SPI_1, offset);
0716:  MOVFF  49,5E
071A:  RCALL  01DE
.................... 
....................    for(index = 0; index < size; index++)
071C:  CLRF   4A
071E:  MOVF   48,W
0720:  SUBWF  4A,W
0722:  BC    0740
....................       spi_xfer(SPI_1, *(data + index));
